rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isViveLojaAdmin() {
      return request.auth != null
        && (request.auth.token.admin == true
          || request.auth.token.role == 'admin'
          || request.auth.token.email == 'sukogames1996@gmail.com');
    }

    function isAssignedMerchant(placeId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/missionRewardMerchants/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/missionRewardMerchants/$(request.auth.uid)).data.active == true
        && firestore.get(/databases/(default)/documents/missionRewardMerchants/$(request.auth.uid)).data.placeIds is list
        && placeId in firestore.get(/databases/(default)/documents/missionRewardMerchants/$(request.auth.uid)).data.placeIds;
    }

    function hasBusinessOwnerAccess(placeId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/businessAccess/$(request.auth.uid + '_' + placeId))
        && firestore.get(/databases/(default)/documents/businessAccess/$(request.auth.uid + '_' + placeId)).data.active == true
        && firestore.get(/databases/(default)/documents/businessAccess/$(request.auth.uid + '_' + placeId)).data.uid == request.auth.uid
        && firestore.get(/databases/(default)/documents/businessAccess/$(request.auth.uid + '_' + placeId)).data.placeId == placeId
        && firestore.get(/databases/(default)/documents/businessAccess/$(request.auth.uid + '_' + placeId)).data.role == 'owner';
    }

    function canManageMerchantImages(placeId) {
      return hasBusinessOwnerAccess(placeId)
        || (request.auth != null
          && !firestore.exists(/databases/(default)/documents/businessAccess/$(request.auth.uid + '_' + placeId))
          && isAssignedMerchant(placeId));
    }

    function validMerchantImage() {
      return request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /audioguias/{allPaths=**} {
      allow read: if true;
      allow create, update: if isViveLojaAdmin()
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow delete: if isViveLojaAdmin();
    }

    match /merchants/{userId}/{placeId}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && canManageMerchantImages(placeId)
        && validMerchantImage();
      allow delete: if request.auth != null
        && request.auth.uid == userId
        && canManageMerchantImages(placeId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
