\pard\qc\sa260\f1\fs26\b\cf2 CULTURA Y CUCHARA / VIVE LOJA\par
\pard\qc\sa240\f1\fs52\b\cf1 MANUAL COMPLETO DE LA WEB\par
\pard\qc\sa200\f0\fs26\cf4 Visitantes, administración, Chabaquito, Pasaporte, recompensas, portal de negocios, Firebase y solución de problemas\par
