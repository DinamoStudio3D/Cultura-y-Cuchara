\pard\s2 23. Procedimientos de emergencia\par
\pard\s3 23.1 Pausar temporalmente el sitio\par
\pard\li540\fi-270\sa80\sl240\slmult1 1.\tab Active Modo en construcci\u243?n.\par
\pard\li540\fi-270\sa80\sl240\slmult1 2.\tab Explique brevemente la causa y canal de contacto.\par
\pard\li540\fi-270\sa80\sl240\slmult1 3.\tab No elimine contenido mientras investiga.\par
\pard\li540\fi-270\sa80\sl240\slmult1 4.\tab Descargue respaldo y registre la hora del incidente.\par
\pard\s3 23.2 Sospecha de acceso no autorizado\par
\pard\li540\fi-270\sa80\sl240\slmult1 1.\tab Cambie inmediatamente la contrase\u241?a de la cuenta afectada y cierre sesiones.\par
\pard\li540\fi-270\sa80\sl240\slmult1 2.\tab Suspenda accesos de negocios relacionados.\par
\pard\li540\fi-270\sa80\sl240\slmult1 3.\tab Revise c\u243?digos entregados, eventos y cambios recientes.\par
\pard\li540\fi-270\sa80\sl240\slmult1 4.\tab No publique capturas con datos personales.\par
\pard\li540\fi-270\sa80\sl240\slmult1 5.\tab Restaure solo despu\u233?s de entender el alcance.\par
\pard\s3 23.3 Campa\u241?a con errores\par
\pard\li540\fi-270\sa80\sl240\slmult1 1.\tab Desactive la campa\u241?a para detener nuevos reclamos.\par
\pard\li540\fi-270\sa80\sl240\slmult1 2.\tab Conserve reclamos existentes y exporte CSV.\par
\pard\li540\fi-270\sa80\sl240\slmult1 3.\tab Corrija configuraci\u243?n o reglas en pruebas.\par
\pard\li540\fi-270\sa80\sl240\slmult1 4.\tab Informe a negocios validadores qu\u233? c\u243?digos siguen siendo v\u225?lidos.\par
\pard\li540\fi-270\sa80\sl240\slmult1 5.\tab Reactive con el mismo identificador solo si las condiciones no cambiaron; de lo contrario cree una campa\u241?a nueva.\par
