{
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/parada/:slug",
      "destination": "/negocio.html?lugar=:slug"
    },
    {
      "source": "/parada/:slug/",
      "destination": "/negocio.html?lugar=:slug"
    }
  ]
}
