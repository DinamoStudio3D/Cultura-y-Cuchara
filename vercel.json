{
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sandbox/config.json",
      "destination": "/api/reward-sandbox?config=1"
    },
    {
      "source": "/reward-programs-v2/:role/:operation",
      "destination": "/api/reward-sandbox?role=:role&operation=:operation"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "qr"
        }
      ],
      "destination": "/qr.html"
    },
    {
      "source": "/canton/:canton",
      "destination": "/api/categoria-seo?canton=:canton"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/parada/:slug",
      "destination": "/api/parada?slug=:slug"
    },
    {
      "source": "/parada/:slug/",
      "destination": "/api/parada?slug=:slug"
    },
    {
      "source": "/hoteles-en-loja",
      "destination": "/api/categoria-seo?categoria=hoteles-en-loja"
    },
    {
      "source": "/restaurantes-en-loja",
      "destination": "/api/categoria-seo?categoria=restaurantes-en-loja"
    },
    {
      "source": "/cafeterias-en-loja",
      "destination": "/api/categoria-seo?categoria=cafeterias-en-loja"
    },
    {
      "source": "/que-hacer-en-loja",
      "destination": "/api/categoria-seo?categoria=que-hacer-en-loja"
    },
    {
      "source": "/huecas-en-loja",
      "destination": "/api/categoria-seo?categoria=huecas-en-loja"
    },
    {
      "source": "/panaderias-en-loja",
      "destination": "/api/categoria-seo?categoria=panaderias-en-loja"
    },
    {
      "source": "/heladerias-en-loja",
      "destination": "/api/categoria-seo?categoria=heladerias-en-loja"
    },
    {
      "source": "/bares-en-loja",
      "destination": "/api/categoria-seo?categoria=bares-en-loja"
    },
    {
      "source": "/entretenimiento-en-loja",
      "destination": "/api/categoria-seo?categoria=entretenimiento-en-loja"
    },
    {
      "source": "/artesanias-en-loja",
      "destination": "/api/categoria-seo?categoria=artesanias-en-loja"
    },
    {
      "source": "/marcas-aliadas-en-loja",
      "destination": "/api/categoria-seo?categoria=marcas-aliadas-en-loja"
    }
  ],
  "buildCommand": "npm run build:css",
  "outputDirectory": "."
}
