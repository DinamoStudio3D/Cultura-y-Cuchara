{
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/parada/:slug",
      "destination": "/api/parada?slug=:slug"
    },
    {
      "source": "/parada/:slug/",
      "destination": "/api/parada?slug=:slug"
    }
  ]
}
