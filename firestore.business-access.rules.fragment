// VisitaLoja.com — integrar dentro de match /databases/{database}/documents antes del deny final.
// NO desplegar por separado.

function businessAccessId(placeId) {
  return placeId + '__' + request.auth.token.email;
}

function hasBusinessAccess(placeId) {
  return request.auth != null
    && request.auth.token.email is string
    && exists(/databases/$(database)/documents/businessAccess/$(businessAccessId(placeId)))
    && get(/databases/$(database)/documents/businessAccess/$(businessAccessId(placeId))).data.active == true
    && get(/databases/$(database)/documents/businessAccess/$(businessAccessId(placeId))).data.placeId == placeId
    && get(/databases/$(database)/documents/businessAccess/$(businessAccessId(placeId))).data.email == request.auth.token.email
    && get(/databases/$(database)/documents/businessAccess/$(businessAccessId(placeId))).data.role in ['owner', 'manager'];
}

// Propietario O encargado: operación diaria del negocio.
function isOperationalBusinessUser(placeId) {
  return hasBusinessAccess(placeId);
}

// SOLO propietario: edición de ficha e imágenes.
function isBusinessOwner(placeId) {
  return hasBusinessAccess(placeId)
    && get(/databases/$(database)/documents/businessAccess/$(businessAccessId(placeId))).data.role == 'owner';
}

// Helper de migración para confirmar visitas/fidelidad.
// Conserva las cuentas antiguas mientras businessAccess entra en funcionamiento.
function isAssignedVisitMerchantV2(placeId) {
  return isOperationalBusinessUser(placeId) || isAssignedVisitMerchant(placeId);
}

// Edición sensible de locales para el esquema nuevo.
// Un manager nunca satisface esta función aunque manipule el navegador.
function canBusinessOwnerEditLocale(placeId) {
  return isBusinessOwner(placeId)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      'desc', 'description', 'phone', 'whatsapp', 'hours',
      'customLogoUrl', 'heroImage', 'gallery',
      'merchantUpdatedAt', 'merchantUpdatedBy'
    ])
    && (!('desc' in request.resource.data)
      || (request.resource.data.desc is string && request.resource.data.desc.size() <= 1200))
    && (!('description' in request.resource.data)
      || (request.resource.data.description is string && request.resource.data.description.size() <= 1200))
    && request.resource.data.phone is string
    && request.resource.data.phone.size() <= 30
    && request.resource.data.whatsapp is string
    && request.resource.data.whatsapp.size() <= 30
    && request.resource.data.hours is string
    && request.resource.data.hours.size() <= 600
    && request.resource.data.customLogoUrl is string
    && request.resource.data.customLogoUrl.size() <= 2000
    && request.resource.data.heroImage is string
    && request.resource.data.heroImage.size() <= 2000
    && request.resource.data.gallery is list
    && request.resource.data.gallery.size() <= 6
    && request.resource.data.merchantUpdatedAt == request.time
    && request.resource.data.merchantUpdatedBy == request.auth.uid;
}

// INTEGRACIÓN REQUERIDA EN firestore.rules (cuando autoricemos el despliegue):
// 1. Los matches de visitas/fidelidad/premios que hoy usen isAssignedVisitMerchant(placeId)
//    deberán aceptar isAssignedVisitMerchantV2(placeId), o equivalentemente añadir
//    isOperationalBusinessUser(placeId) al permiso existente.
// 2. match /locales/{documentId} deberá usar:
//    allow update: if isViveLojaAdmin()
//      || canBusinessOwnerEditLocale(documentId)
//      || canMerchantEditLocale(documentId); // fallback legado temporal
// 3. NO usar isOperationalBusinessUser() para editar /locales: manager es solo operativo.
// 4. Retirar los fallbacks legacy únicamente después de migrar/probar todas las cuentas.

match /businessAccess/{accessId} {
  allow read: if isViveLojaAdmin()
    || (request.auth != null
      && request.auth.token.email is string
      && resource.data.email == request.auth.token.email
      && resource.data.active == true);

  allow create: if isViveLojaAdmin()
    && request.resource.data.keys().hasOnly([
      'email', 'displayName', 'placeId', 'placeName', 'role', 'active',
      'updatedAt', 'updatedBy'
    ])
    && request.resource.data.email is string
    && request.resource.data.email.size() >= 5
    && request.resource.data.email.size() <= 254
    && request.resource.data.displayName is string
    && request.resource.data.displayName.size() <= 120
    && request.resource.data.placeId is string
    && request.resource.data.placeId.size() > 0
    && request.resource.data.placeId.size() <= 160
    && exists(/databases/$(database)/documents/locales/$(request.resource.data.placeId))
    && request.resource.data.placeName is string
    && request.resource.data.placeName.size() <= 180
    && request.resource.data.role in ['owner', 'manager']
    && request.resource.data.active is bool
    && request.resource.data.updatedAt == request.time
    && request.resource.data.updatedBy == request.auth.uid
    && accessId == request.resource.data.placeId + '__' + request.resource.data.email;

  allow update: if isViveLojaAdmin()
    && request.resource.data.keys().hasOnly([
      'email', 'displayName', 'placeId', 'placeName', 'role', 'active',
      'updatedAt', 'updatedBy'
    ])
    && request.resource.data.email == resource.data.email
    && request.resource.data.placeId == resource.data.placeId
    && request.resource.data.placeName is string
    && request.resource.data.placeName.size() <= 180
    && request.resource.data.displayName is string
    && request.resource.data.displayName.size() <= 120
    && request.resource.data.role in ['owner', 'manager']
    && request.resource.data.active is bool
    && request.resource.data.updatedAt == request.time
    && request.resource.data.updatedBy == request.auth.uid
    && accessId == resource.data.placeId + '__' + resource.data.email;

  allow delete: if isViveLojaAdmin();
}
