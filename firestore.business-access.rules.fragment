// VisitaLoja.com — integrar dentro de match /databases/{database}/documents antes del deny final.
// NO desplegar por separado.

function businessAccessId(placeId) {
  return placeId + '__' + request.auth.token.email;
}

function hasBusinessAccess(placeId) {
  return request.auth != null
    && request.auth.token.email is string
    && exists(/databases/$(database)/documents/businessAccess/$(businessAccessId(placeId)))
    && get(/databases/$(database)/documents/businessAccess/$(businessAccessId(placeId))).data.active == true
    && get(/databases/$(database)/documents/businessAccess/$(businessAccessId(placeId))).data.placeId == placeId
    && get(/databases/$(database)/documents/businessAccess/$(businessAccessId(placeId))).data.email == request.auth.token.email
    && get(/databases/$(database)/documents/businessAccess/$(businessAccessId(placeId))).data.role in ['owner', 'manager'];
}

// Operación diaria del negocio: propietario O encargado.
// Usar para confirmar visitas, fidelidad y entrega/validación de premios.
function isOperationalBusinessUser(placeId) {
  return hasBusinessAccess(placeId);
}

// Autogestión sensible del negocio: SOLO propietario.
// Usar para editar ficha, contacto, horarios, logo, portada y galería.
function isBusinessOwner(placeId) {
  return hasBusinessAccess(placeId)
    && get(/databases/$(database)/documents/businessAccess/$(businessAccessId(placeId))).data.role == 'owner';
}

// Compatibilidad durante la migración:
// - isAssignedVisitMerchant(placeId) debe aceptar isOperationalBusinessUser(placeId)
//   además del esquema legado missionRewardMerchants.
// - canMerchantEditLocale(placeId) debe aceptar isBusinessOwner(placeId), NO
//   isOperationalBusinessUser(placeId), para impedir que un encargado edite la ficha.
// El fallback legado se retirará únicamente después de migrar y probar las cuentas existentes.

match /businessAccess/{accessId} {
  allow read: if isViveLojaAdmin()
    || (request.auth != null
      && request.auth.token.email is string
      && resource.data.email == request.auth.token.email
      && resource.data.active == true);

  allow create: if isViveLojaAdmin()
    && request.resource.data.keys().hasOnly([
      'email', 'displayName', 'placeId', 'placeName', 'role', 'active',
      'updatedAt', 'updatedBy'
    ])
    && request.resource.data.email is string
    && request.resource.data.email.size() >= 5
    && request.resource.data.email.size() <= 254
    && request.resource.data.displayName is string
    && request.resource.data.displayName.size() <= 120
    && request.resource.data.placeId is string
    && request.resource.data.placeId.size() > 0
    && request.resource.data.placeId.size() <= 160
    && exists(/databases/$(database)/documents/locales/$(request.resource.data.placeId))
    && request.resource.data.placeName is string
    && request.resource.data.placeName.size() <= 180
    && request.resource.data.role in ['owner', 'manager']
    && request.resource.data.active is bool
    && request.resource.data.updatedAt == request.time
    && request.resource.data.updatedBy == request.auth.uid
    && accessId == request.resource.data.placeId + '__' + request.resource.data.email;

  allow update: if isViveLojaAdmin()
    && request.resource.data.keys().hasOnly([
      'email', 'displayName', 'placeId', 'placeName', 'role', 'active',
      'updatedAt', 'updatedBy'
    ])
    && request.resource.data.email == resource.data.email
    && request.resource.data.placeId == resource.data.placeId
    && request.resource.data.placeName is string
    && request.resource.data.placeName.size() <= 180
    && request.resource.data.displayName is string
    && request.resource.data.displayName.size() <= 120
    && request.resource.data.role in ['owner', 'manager']
    && request.resource.data.active is bool
    && request.resource.data.updatedAt == request.time
    && request.resource.data.updatedBy == request.auth.uid
    && accessId == resource.data.placeId + '__' + resource.data.email;

  allow delete: if isViveLojaAdmin();
}
